<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ووچینو - پنل اشتراک VPN</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        @font-face {
            font-family: 'Vazir';
            src: url('https://cdn.jsdelivr.net/gh/rastikerdar/vazir-font@v30.1.0/dist/Vazir-Regular.eot');
            src: url('https://cdn.jsdelivr.net/gh/rastikerdar/vazir-font@v30.1.0/dist/Vazir-Regular.eot?#iefix') format('embedded-opentype'),
                 url('https://cdn.jsdelivr.net/gh/rastikerdar/vazir-font@v30.1.0/dist/Vazir-Regular.woff2') format('woff2'),
                 url('https://cdn.jsdelivr.net/gh/rastikerdar/vazir-font@v30.1.0/dist/Vazir-Regular.woff') format('woff'),
                 url('https://cdn.jsdelivr.net/gh/rastikerdar/vazir-font@v30.1.0/dist/Vazir-Regular.ttf') format('truetype');
            font-weight: normal;
            font-style: normal;
        }
        
        @font-face {
            font-family: 'Vazir';
            src: url('https://cdn.jsdelivr.net/gh/rastikerdar/vazir-font@v30.1.0/dist/Vazir-Bold.eot');
            src: url('https://cdn.jsdelivr.net/gh/rastikerdar/vazir-font@v30.1.0/dist/Vazir-Bold.eot?#iefix') format('embedded-opentype'),
                 url('https://cdn.jsdelivr.net/gh/rastikerdar/vazir-font@v30.1.0/dist/Vazir-Bold.woff2') format('woff2'),
                 url('https://cdn.jsdelivr.net/gh/rastikerdar/vazir-font@v30.1.0/dist/Vazir-Bold.woff') format('woff'),
                 url('https://cdn.jsdelivr.net/gh/rastikerdar/vazir-font@v30.1.0/dist/Vazir-Bold.ttf') format('truetype');
            font-weight: bold;
            font-style: normal;
        }
        
        body {
            font-family: 'Vazir', Tahoma, Arial, sans-serif;
            background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            margin: 0;
        }
        
        .container {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 30px;
            padding: 40px;
            max-width: 520px;
            width: 100%;
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
            position: relative;
            overflow: hidden;
        }
        
        .container::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle at 30% 50%, rgba(247, 151, 30, 0.03), transparent 60%);
            pointer-events: none;
        }
        
        .logo {
            text-align: center;
            margin-bottom: 30px;
            position: relative;
            z-index: 1;
        }
        
        .logo h1 {
            color: #fff;
            font-size: 32px;
            font-weight: 700;
            letter-spacing: 0px;
        }
        
        .logo h1 span {
            color: #f7971e;
            background: linear-gradient(135deg, #f7971e, #ffd200);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .logo .subtitle {
            color: #888;
            font-size: 13px;
            margin-top: 4px;
            letter-spacing: 1px;
        }
        
        .user-info {
            background: rgba(255, 255, 255, 0.06);
            border-radius: 16px;
            padding: 20px 24px;
            margin-bottom: 20px;
            border: 1px solid rgba(255, 255, 255, 0.05);
            position: relative;
            z-index: 1;
        }
        
        .user-info .row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 6px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        }
        
        .user-info .row:last-child {
            border-bottom: none;
        }
        
        .user-info .label {
            color: #888;
            font-size: 13px;
        }
        
        .user-info .value {
            color: #fff;
            font-size: 14px;
            font-weight: 500;
        }
        
        .user-info .value.mono {
            font-family: 'Courier New', monospace;
            font-size: 13px;
            color: #f7971e;
            background: rgba(247, 151, 30, 0.1);
            padding: 2px 10px;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s;
            user-select: all;
        }
        
        .user-info .value.mono:hover {
            background: rgba(247, 151, 30, 0.2);
        }
        
        .status-card {
            background: linear-gradient(135deg, rgba(247, 151, 30, 0.12), rgba(255, 200, 0, 0.04));
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 20px;
            border: 1px solid rgba(247, 151, 30, 0.15);
            position: relative;
            z-index: 1;
        }
        
        .status-card .title {
            color: #f7971e;
            font-size: 17px;
            font-weight: 600;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .status-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }
        
        .status-item:last-child {
            border-bottom: none;
        }
        
        .status-item .label {
            color: #999;
            font-size: 13px;
        }
        
        .status-item .value {
            font-size: 14px;
            font-weight: 600;
        }
        
        .value.active {
            color: #4caf50;
        }
        
        .value.warning {
            color: #f7971e;
        }
        
        .value.danger {
            color: #f44336;
        }
        
        .value.mono-small {
            font-family: 'Courier New', monospace;
            font-size: 12px;
            color: #aaa;
        }
        
        .progress-container {
            margin-top: 12px;
        }
        
        .progress-label {
            display: flex;
            justify-content: space-between;
            color: #999;
            font-size: 12px;
            margin-bottom: 4px;
        }
        
        .progress-bar {
            width: 100%;
            height: 6px;
            background: rgba(255, 255, 255, 0.08);
            border-radius: 10px;
            overflow: hidden;
        }
        
        .progress-bar .fill {
            height: 100%;
            background: linear-gradient(90deg, #4caf50, #f7971e);
            border-radius: 10px;
            transition: width 0.8s ease;
        }
        
        .qr-container {
            text-align: center;
            margin: 20px 0 16px 0;
            position: relative;
            z-index: 1;
        }
        
        .qr-container .qr-wrapper {
            display: inline-block;
            background: #fff;
            padding: 10px;
            border-radius: 16px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
        }
        
        .qr-container img {
            width: 160px;
            height: 160px;
            display: block;
            border-radius: 8px;
        }
        
        .qr-container .qr-label {
            color: #888;
            font-size: 12px;
            margin-top: 8px;
        }
        
        .link-box {
            background: rgba(255, 255, 255, 0.04);
            border-radius: 10px;
            padding: 10px 14px;
            margin: 10px 0 16px 0;
            border: 1px solid rgba(255, 255, 255, 0.06);
            text-align: center;
            position: relative;
            z-index: 1;
        }
        
        .link-box code {
            font-family: 'Courier New', monospace;
            font-size: 12px;
            color: #f7971e;
            word-break: break-all;
            background: rgba(247, 151, 30, 0.08);
            padding: 4px 12px;
            border-radius: 6px;
            display: inline-block;
        }
        
        .stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin: 16px 0;
            position: relative;
            z-index: 1;
        }
        
        .stat-box {
            background: rgba(255, 255, 255, 0.04);
            border-radius: 12px;
            padding: 14px;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.04);
        }
        
        .stat-box .number {
            color: #f7971e;
            font-size: 22px;
            font-weight: 700;
        }
        
        .stat-box .label {
            color: #888;
            font-size: 12px;
            margin-top: 2px;
        }
        
        .banner {
            background: linear-gradient(135deg, rgba(247, 151, 30, 0.08), rgba(255, 200, 0, 0.03));
            border-radius: 12px;
            padding: 16px 18px;
            margin: 16px 0;
            border: 1px solid rgba(247, 151, 30, 0.1);
            text-align: center;
            position: relative;
            z-index: 1;
        }
        
        .banner p {
            color: #ccc;
            font-size: 13px;
            line-height: 2;
        }
        
        .banner strong {
            color: #f7971e;
        }
        
        .btn {
            display: block;
            width: 100%;
            padding: 15px;
            border: none;
            border-radius: 14px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            text-align: center;
            text-decoration: none;
            margin: 8px 0;
            transition: all 0.3s ease;
            font-family: 'Vazir', Tahoma, Arial, sans-serif;
            position: relative;
            z-index: 1;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, #f7971e, #ffd200);
            color: #1a1a2e;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(247, 151, 30, 0.25);
        }
        
        .btn-secondary {
            background: rgba(255, 255, 255, 0.08);
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.12);
        }
        
        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.15);
            transform: translateY(-2px);
        }
        
        .btn-outline {
            background: transparent;
            color: #f7971e;
            border: 2px solid #f7971e;
        }
        
        .btn-outline:hover {
            background: #f7971e;
            color: #1a1a2e;
            transform: translateY(-2px);
        }
        
        .btn-success {
            background: linear-gradient(135deg, #43a047, #66bb6a);
            color: #fff;
        }
        
        .btn-success:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(76, 175, 80, 0.25);
        }
        
        .btn-group {
            display: flex;
            gap: 10px;
            margin: 8px 0;
            position: relative;
            z-index: 1;
        }
        
        .btn-group .btn {
            flex: 1;
            margin: 0;
        }
        
        .footer {
            text-align: center;
            margin-top: 25px;
            color: #555;
            font-size: 12px;
            position: relative;
            z-index: 1;
            border-top: 1px solid rgba(255, 255, 255, 0.04);
            padding-top: 20px;
        }
        
        .footer a {
            color: #f7971e;
            text-decoration: none;
        }
        
        .footer a:hover {
            text-decoration: underline;
        }
        
        .badge {
            display: inline-block;
            padding: 2px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }
        
        .badge-gold {
            background: linear-gradient(135deg, #f7971e, #ffd200);
            color: #1a1a2e;
        }
        
        .badge-silver {
            background: rgba(255, 255, 255, 0.1);
            color: #ccc;
        }
        
        .badge-verified {
            background: rgba(76, 175, 80, 0.2);
            color: #4caf50;
        }
        
        .empty-state {
            text-align: center;
            padding: 30px 0;
            color: #888;
        }
        
        .empty-state .icon {
            font-size: 48px;
            margin-bottom: 12px;
        }
        
        .empty-state h3 {
            color: #fff;
            margin-bottom: 8px;
        }
        
        @media (max-width: 480px) {
            .container {
                padding: 20px;
                border-radius: 20px;
            }
            
            .stats {
                grid-template-columns: 1fr;
            }
            
            .btn-group {
                flex-direction: column;
            }
            
            .logo h1 {
                font-size: 24px;
            }
            
            .user-info .row {
                flex-direction: column;
                align-items: flex-start;
                gap: 4px;
            }
        }
        
        @media (max-width: 380px) {
            .container {
                padding: 14px;
            }
            
            .qr-container img {
                width: 120px;
                height: 120px;
            }
        }
        
        .toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 0, 0, 0.85);
            color: #fff;
            padding: 12px 28px;
            border-radius: 12px;
            font-size: 14px;
            z-index: 999;
            display: none;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }
        
        .toast.show {
            display: block;
            animation: fadeInUp 0.3s ease;
        }
        
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateX(-50%) translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }
        }
        
        .glow {
            animation: glow 2s ease-in-out infinite alternate;
        }
        
        @keyframes glow {
            from {
                box-shadow: 0 0 20px rgba(247, 151, 30, 0.1);
            }
            to {
                box-shadow: 0 0 40px rgba(247, 151, 30, 0.2);
            }
        }
    </style>
</head>
<body>

    <div class="container glow">
        <div class="logo">
            <h1>⚜️ <span>ووچینو</span>⁰¹</h1>
            <div class="subtitle">مرجع تخصصی معاملات ووچر</div>
        </div>

        <div class="user-info">
            <div class="row">
                <span class="label">👤 نام کاربری</span>
                <span class="value"><%= user.full_name || 'کاربر مهمان' %></span>
            </div>
            <div class="row">
                <span class="label">🆔 آیدی تلگرام</span>
                <span class="value mono" onclick="copyToClipboard('<%= user.telegram_id %>')"><%= user.telegram_id %></span>
            </div>
            <div class="row">
                <span class="label">📱 شماره تماس</span>
                <span class="value"><%= user.phone || 'ثبت نشده' %></span>
            </div>
            <div class="row">
                <span class="label">🏅 سطح کاربری</span>
                <span class="value">
                    <% if (user.verification_status === 'verified') { %>
                        <span class="badge badge-gold">🥇 طلایی</span>
                    <% } else { %>
                        <span class="badge badge-silver">🥈 نقره‌ای</span>
                    <% } %>
                    <% if (user.verification_status === 'verified') { %>
                        <span class="badge badge-verified">✅ تأیید شده</span>
                    <% } %>
                </span>
            </div>
        </div>

        <div class="status-card">
            <div class="title">🌐 وضعیت اشتراک VPN</div>
            
            <% if (subscription && daysLeft > 0) { %>
                <div class="status-item">
                    <span class="label">📅 روزهای باقی‌مانده</span>
                    <span class="value <%= daysLeft > 10 ? 'active' : daysLeft > 5 ? 'warning' : 'danger' %>">
                        <%= daysLeft %> روز
                    </span>
                </div>
                <div class="status-item">
                    <span class="label">📊 حجم مصرفی</span>
                    <span class="value">
                        <%= (dataUsed / (1024 * 1024)).toFixed(2) %> مگابایت
                    </span>
                </div>
                <div class="progress-container">
                    <div class="progress-label">
                        <span>مصرف</span>
                        <span><%= Math.min(Math.round((dataUsed / dataLimit) * 100), 100) %>%</span>
                    </div>
                    <div class="progress-bar">
                        <div class="fill" style="width: <%= Math.min((dataUsed / dataLimit) * 100, 100) %>%"></div>
                    </div>
                </div>
                <div class="status-item" style="margin-top: 12px;">
                    <span class="label">🆔 کد پیگیری</span>
                    <span class="value mono-small"><%= subscription.tracking_code %></span>
                </div>
                <div class="status-item">
                    <span class="label">📅 تاریخ انقضا</span>
                    <span class="value"><%= new Date(subscription.expires_at).toLocaleDateString('fa-IR') %></span>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <div class="icon">🔒</div>
                    <h3>سرویس فعالی یافت نشد</h3>
                    <p style="color: #888; font-size: 13px;">برای دریافت سرویس VPN، به ربات مراجعه کنید</p>
                    <br>
                    <a href="https://t.me/Vochino01_bot" class="btn btn-primary" style="display: inline-block; width: auto; padding: 12px 35px; font-size: 14px;">
                        🚀 دریافت سرویس
                    </a>
                </div>
            <% } %>
        </div>

        <div class="qr-container">
            <div class="qr-wrapper">
                <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=<%= baseUrl %>/sub/<%= user.telegram_id %>" alt="QR Code">
            </div>
            <div class="qr-label">📷 لینک اشتراک خود را اسکن کنید</div>
        </div>

        <div class="link-box">
            <code id="subLink"><%= baseUrl %>/sub/<%= user.telegram_id %></code>
            <br>
            <button onclick="copyLink()" style="background: none; border: none; color: #f7971e; cursor: pointer; font-size: 12px; margin-top: 4px; font-family: 'Vazir', Tahoma, Arial, sans-serif;">
                📋 کپی لینک
            </button>
        </div>

        <div class="stats">
            <div class="stat-box">
                <div class="number"><%= totalUsers %></div>
                <div class="label">👥 کاربران ووچینو</div>
            </div>
            <div class="stat-box">
                <div class="number"><%= activeOrders %></div>
                <div class="label">🛒 خرید هفته‌ی اخیر</div>
            </div>
        </div>

        <div class="banner">
            <p>
                💰 <strong>خرید و فروش ووچر</strong> با بهترین نرخ روز و کارمزد پایین<br>
                🔥 <strong>اشتراک VPN اختصاصی</strong> با بالاترین سرعت و امنیت
            </p>
        </div>

        <a href="https://t.me/Vochino01_bot" class="btn btn-primary">
            🚀 ورود به ربات ووچینو
        </a>

        <div class="btn-group">
            <a href="https://t.me/Vochino01_bot?start=buy" class="btn btn-secondary">
                🛍 خرید ووچر
            </a>
            <a href="https://t.me/Vochino01_bot?start=vpn" class="btn btn-secondary">
                🌐 خرید VPN
            </a>
        </div>

        <div class="footer">
            ⚜️ ووچینو⁰¹ | مرجع تخصصی معاملات ووچر<br>
            <a href="https://t.me/Vochino01_bot">@Vochino01_bot</a>
            <br><br>
            <span style="color: #444; font-size: 11px;">© 2026 Vochino - تمامی حقوق محفوظ است</span>
        </div>
    </div>

    <div class="toast" id="toast"></div>

    <script>
        function copyToClipboard(text) {
            if (navigator.clipboard) {
                navigator.clipboard.writeText(text).then(function() {
                    showToast('✅ کپی شد: ' + text);
                }).catch(function() {
                    fallbackCopy(text);
                });
            } else {
                fallbackCopy(text);
            }
        }
        
        function fallbackCopy(text) {
            var textarea = document.createElement('textarea');
            textarea.value = text;
            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';
            document.body.appendChild(textarea);
            textarea.select();
            try {
                document.execCommand('copy');
                showToast('✅ کپی شد: ' + text);
            } catch (err) {
                showToast('❌ کپی ناموفق');
            }
            document.body.removeChild(textarea);
        }
        
        function copyLink() {
            var link = document.getElementById('subLink').textContent;
            copyToClipboard(link);
        }
        
        function showToast(message) {
            var toast = document.getElementById('toast');
            toast.textContent = message;
            toast.className = 'toast show';
            clearTimeout(toast._timeout);
            toast._timeout = setTimeout(function() {
                toast.className = 'toast';
            }, 2500);
        }
        
        document.addEventListener('DOMContentLoaded', function() {
            var progressFill = document.querySelector('.progress-bar .fill');
            if (progressFill) {
                var width = progressFill.style.width;
                progressFill.style.width = '0%';
                setTimeout(function() {
                    progressFill.style.width = width;
                }, 300);
            }
        });
    </script>

</body>
</html>
